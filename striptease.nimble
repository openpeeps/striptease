# Package

version       = "0.4.0"
author        = "George Lemon"
description   = "Strip metadata tags from audio, image, raw and video files plus invisible Unicode in text (WAV, JPEG, PNG, GIF, WebP, TIFF RAW, CR3, HEIC, MP4/MOV, AVI, MKV, TXT/MD/JSON/HTML)"
license       = "MIT"
srcDir        = "src"
bin           = @["striptease"]


# Dependencies

requires "nim >= 2.2.10"
