# Package

version       = "0.3.0"
author        = "George Lemon"
description   = "Strip metadata tags from audio, image, raw and video files (WAV, JPEG, PNG, GIF, WebP, TIFF RAW, CR3, HEIC, MP4/MOV, AVI, MKV)"
license       = "MIT"
srcDir        = "src"
bin           = @["striptease"]


# Dependencies

requires "nim >= 2.2.12"
