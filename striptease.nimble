# Package

version       = "0.2.0"
author        = "George Lemon"
description   = "Strip metadata tags from audio, image and video files (WAV, JPEG, PNG, GIF, WebP, MP4/MOV, AVI, MKV)"
license       = "MIT"
srcDir        = "src"
bin           = @["striptease"]


# Dependencies

requires "nim >= 2.2.12"
